#!/bin/bash

CLI="/opt/wildfly/bin/jboss-cli.sh --connect --controller=${option.DC_IP}:9990"
ACTION="@option.ACTION@"
SCOPE="@option.SCOPE@"

# --- EXECUTION PHASE ---
if [ "$SCOPE" == "Cluster" ]; then
    TARGET="@option.CLUSTER_NAME@"
    echo "Action: $ACTION on Cluster: $TARGET"
    $CLI --command="/server-group=$TARGET:$ACTION-servers(blocking=true)"
else
    TARGET="@option.SERVER_NAME@"
    HOST="@option.TARGET_HOST@"
    echo "Action: $ACTION on Server: $TARGET (Host: $HOST)"
    $CLI --command="/host=$HOST/server=$TARGET:$ACTION(blocking=true)"
fi

# --- STATUS REPORTING PHASE ---
echo -e "\n======================================================"
echo -e "CURRENT DOMAIN STATUS REPORT"
echo -e "======================================================"
printf "%-15s | %-15s | %-10s | %-10s\n" "HOST" "SERVER" "GROUP" "STATUS"
echo "------------------------------------------------------"

# Querying all hosts and their server-configs to get a summary
# We use 'read-resource' with 'include-runtime' to get the live status
$CLI --command="/host=*/server-config=*:read-resource(include-runtime=true)" | \
awk -v cluster="@option.CLUSTER_NAME@" '
    /\// { split($1, a, "/"); host=substr(a[2], 6); server=substr(a[3], 15); }
    /"group" =>/ { group=substr($3, 2, length($3)-3); }
    /"status" =>/ { 
        status=substr($3, 2, length($3)-3);
        # Only show the cluster we are interested in, or all if scope is individual
        if (group == cluster || "'$SCOPE'" == "Individual-Server") {
            printf "%-15s | %-15s | %-10s | %-10s\n", host, server, group, status
        }
    }
'
echo "======================================================"
