#!/bin/bash

# Configuration
CLI="/opt/wildfly/bin/jboss-cli.sh --connect --controller=${option.DC_IP}:9990"
ACTION="@option.ACTION@"
SCOPE="@option.SCOPE@"
CLUSTER="@option.CLUSTER_NAME@"
MAX_RETRIES=15  # Increased to 15 (2.5 minutes)

echo "Executing $ACTION on $SCOPE..."

if [ "$SCOPE" == "Cluster" ]; then
    echo "Targeting Cluster: $CLUSTER"
    
    # Execute the command
    $CLI --command="/server-group=$CLUSTER:$ACTION-servers"
    
    echo "Waiting for servers in $CLUSTER to reach $ACTION state..."
    
    # Map Action to Target Status
    if [ "$ACTION" == "start" ]; then TARGET_ST="STARTED"; else TARGET_ST="STOPPED"; fi

    COUNT=0
    while [ $COUNT -lt $MAX_RETRIES ]; do
        # Simplified Check: Ask the DC for the status of all servers in the group
        # This avoids the complex grep/awk that often causes exit 1
        CURRENT_STATES=$($CLI --command="/host=*/server-config=*:read-attribute(name=status)")
        
        # Count how many servers in this cluster are NOT in the target state
        # We look for the server configs assigned to our cluster
        TOTAL_IN_CLUSTER=$($CLI --command="/host=*/server-config=*:read-resource" | grep -c "group\" => \"$CLUSTER\"")
        IN_TARGET_STATE=$($CLI --command="/host=*/server-config=*:read-resource(include-runtime=true)" | grep -B 2 "group\" => \"$CLUSTER\"" | grep -c "status\" => \"$TARGET_ST\"")

        echo "Status: $IN_TARGET_STATE of $TOTAL_IN_CLUSTER servers are $TARGET_ST"

        if [ "$IN_TARGET_STATE" -eq "$TOTAL_IN_CLUSTER" ] && [ "$TOTAL_IN_CLUSTER" -gt 0 ]; then
            echo "SUCCESS: All $TOTAL_IN_CLUSTER servers are now $TARGET_ST."
            exit 0
        fi

        sleep 10
        ((COUNT++))
    done

    echo "TIMEOUT: Only $IN_TARGET_STATE/$TOTAL_IN_CLUSTER servers reached $TARGET_ST."
    exit 1

else
    # Individual Server Logic (using server-config to avoid 'Node type' errors)
    HOST="@option.TARGET_HOST@"
    SERVER="@option.SERVER_NAME@"
    $CLI --command="/host=$HOST/server-config=$SERVER:$ACTION(blocking=true)"
    
    if [ $? -eq 0 ]; then
        echo "SUCCESS: $ACTION completed for $SERVER."
        exit 0
    else
        echo "ERROR: Failed to $ACTION $SERVER."
        exit 1
    fi
fi
