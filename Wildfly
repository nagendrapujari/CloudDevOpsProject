#!/bin/bash

# Configuration
CLI="/opt/wildfly/bin/jboss-cli.sh --connect --controller=${option.DC_IP}:9990"
ACTION="@option.ACTION@"
SCOPE="@option.SCOPE@"

echo "Executing $ACTION on $SCOPE..."

if [ "$SCOPE" == "Cluster" ]; then
    # Target the entire Server Group (All 8 nodes)
    CLUSTER="@option.CLUSTER_NAME@"
    echo "Targeting Cluster: $CLUSTER"
    $CLI --command="/server-group=$CLUSTER:$ACTION-servers(blocking=true)"

else
    # Target a single instance on a specific Host Controller
    HOST="@option.TARGET_HOST@"
    SERVER="@option.SERVER_NAME@"
    echo "Targeting Server: $SERVER on Host: $HOST"
    
    # Using the modern 'server' resource for individual lifecycle
    $CLI --command="/host=$HOST/server=$SERVER:$ACTION(blocking=true)"
fi

if [ $? -eq 0 ]; then
    echo "SUCCESS: $ACTION completed."
else
    echo "ERROR: $ACTION failed. Check WildFly logs."
    exit 1
fi
